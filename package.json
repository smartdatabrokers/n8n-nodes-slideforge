{
  "name": "n8n-nodes-slideforge",
  "version": "0.1.3",
  "description": "Render editable PowerPoint slides and decks from your n8n workflows with SlideForge",
  "license": "MIT",
  "homepage": "https://slideforge.dev",
  "keywords": [
    "n8n-community-node-package",
    "powerpoint",
    "pptx",
    "slides",
    "presentation",
    "slideforge"
  ],
  "author": {
    "name": "Thomas Seidel",
    "email": "thomas@seidel.info"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smartdatabrokers/n8n-nodes-slideforge.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SlideforgeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Slideforge/Slideforge.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
